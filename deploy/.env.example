# Kopieren nach deploy/.env und anpassen. Keine Geheimnisse hier – die App braucht keine.

# Port auf ai01, auf dem die App erreichbar ist (rp01 leitet dorthin weiter)
MISSA_CHAT_PORT=8080

# API-Adressen, zu denen die App verbinden darf (CSP connect-src), mit Leerzeichen getrennt.
# Mit Heimnetz-Adresse z. B.: https://ki.louis-degiorgi.ch https://ai01.heimnetz.lan
MISSA_API_ORIGINS=https://ki.louis-degiorgi.ch
