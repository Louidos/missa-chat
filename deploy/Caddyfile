# Webserver für die fertige App (dist/). Läuft hinter rp01 (TLS macht rp01).
# Umgebungsvariablen (siehe .env.example):
#   MISSA_API_ORIGINS  – erlaubte API-Adressen für connect-src, mit Leerzeichen getrennt

{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# Strenge CSP: nur eigene Dateien, Verbindungen nur zur eingetragenen Missa-API.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' {$MISSA_API_ORIGINS}; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# Dateien mit Hash im Namen ändern sich nie: lange cachen.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Alles andere (index.html, sw.js, Manifest, Icons) immer frisch prüfen,
	# damit Updates sofort ankommen.
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	# Service Worker darf die ganze App steuern.
	header /sw.js Service-Worker-Allowed "/"

	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Einseitige App: unbekannte Pfade liefern index.html.
	try_files {path} /index.html
	file_server
}
