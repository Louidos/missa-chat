{
  "name": "missa-chat",
  "version": "0.4.0",
  "private": true,
  "description": "Chat-App für Missa – installierbare PWA als Zugang zur Missa-API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "mock-api": "node tests/mock-api/server.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "marked": "^18.2.0"
  }
}
